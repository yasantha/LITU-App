<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Litu" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/background_light</item>
    </style>

    <!-- S01 Splash: logo on brand, same in both themes. -->
    <style name="Theme.Litu.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Litu</item>
    </style>
</resources>
